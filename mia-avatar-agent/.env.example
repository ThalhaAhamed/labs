# MeetStream
MEETSTREAM_API_KEY=

# Anam (avatar provider) — must also be saved under
# MeetStream Dashboard -> Integrations -> Avatar -> Anam
ANAM_API_KEY=

# Anam avatar_id (NOT a persona_id) — run `npm run list-avatars` to fetch one
ANAM_AVATAR_ID=

# Meeting to deploy the avatar bot into
MEETING_LINK=

# Filled in automatically by `npm run create-agent`, or set manually if you
# already have an agent_config_id
MIA_AGENT_CONFIG_ID=

# --- Optional: customize the agent `npm run create-agent` builds ---
# All of these have sensible defaults (see src/createAvatarAgent.js) if left blank.

# MIA_AGENT_NAME=MIA Avatar Agent
# MIA_MODEL_PROVIDER=openai        # e.g. openai, google, xai
# MIA_MODEL_NAME=gpt-realtime-mini # e.g. gpt-realtime-mini, gemini-2.5-flash-native-audio-preview-12-2025
# MIA_MODEL_VOICE=coral            # the model's built-in realtime voice, e.g. coral (openai), Puck (google)
# MIA_MODEL_TEMPERATURE=0.8
# MIA_SYSTEM_PROMPT=You are a helpful AI meeting assistant...
# MIA_FIRST_MESSAGE=Hey there! I am your AI assistant...

# Optional Anam avatar overrides
# ANAM_AVATAR_PROVIDER=anam        # currently anam is the only supported provider
# ANAM_AVATAR_MODEL=               # optional Anam avatarModel override
# ANAM_AVATAR_NAME=                # optional persona display name
