# Copy this file to .env, then replace the placeholder values.
MEETSTREAM_API_KEY=your_meetstream_key_here
OPENAI_API_KEY=your_openai_key_here
DEEPGRAM_API_KEY=your_deepgram_key_here
NGROK_AUTHTOKEN=your_ngrok_token_here
MEETING_LINK=your_meeting_link_here

# Optional settings
PORT=3000
# These phrases are enforced by the local chat bridge.
WAKE_WORD=hey bot,hey assistant
# Use an existing public endpoint instead of the automatic ngrok tunnel.
# CALLBACK_URL=https://your-domain.example/webhooks/meetstream
